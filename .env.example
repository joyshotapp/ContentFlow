# ============================================================
# ContentFlow AI — 環境變數設定範本
# 複製此檔案為 .env 並填入實際金鑰
# ============================================================

# ── LLM API ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# 預設使用的模型
LLM_WRITING_MODEL=claude-sonnet-4-5         # 長文寫作
LLM_LITE_MODEL=gpt-4o-mini                  # 輕量分類/摘要任務

# ── PubMed / NCBI ────────────────────────────────────────────
# 申請：https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@example.com            # NCBI 要求提供聯絡 Email

# ── SERP API ─────────────────────────────────────────────────
# 申請：https://serper.dev（推薦）或 https://serpapi.com
SERPER_API_KEY=your-serper-api-key-here
# SERPAPI_KEY=your-serpapi-key-here          # 備選

# ── 圖片生成 API ──────────────────────────────────────────────
# DALL-E 3 使用 OPENAI_API_KEY，無需額外設定
# Flux / Replicate（備選）
# REPLICATE_API_TOKEN=r8_...

# ── Google API ───────────────────────────────────────────────
# 申請：https://console.cloud.google.com
# 用途：Google Sheets 排程表、Google Docs 匯出
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEETS_SCHEDULE_ID=your-google-sheet-id-here

# ── WordPress ────────────────────────────────────────────────
WORDPRESS_SITE_URL=https://your-site.com
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_APP_PASSWORD=your-wp-app-password  # WordPress Application Password

# ── 資料儲存 ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/contentflow.db
# DATABASE_URL=postgresql://user:password@localhost:5432/contentflow  # 生產環境

# ── 通知 ──────────────────────────────────────────────────────
# Slack Webhook（可選）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── 系統設定 ──────────────────────────────────────────────────
LOG_LEVEL=INFO                               # DEBUG / INFO / WARNING / ERROR
OUTPUT_DIR=./outputs
MAX_ARTICLES_PER_RUN=5                       # 每次批次上限
