# ============================================================
# ContentFlow AI — 環境變數設定範本
# 複製此檔案為 .env 並填入實際金鑰
# ============================================================

# ── LLM API ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── AgentOps 可觀測性 ──────────────────────────────────────────
# 申請：https://app.agentops.ai/settings/projects
# 留空則不啟用（不影響 pipeline 執行）
AGENTOPS_API_KEY=

# 預設使用的模型
LLM_WRITING_MODEL=claude-sonnet-4-5         # 長文寫作
LLM_LITE_MODEL=gpt-4o-mini                  # 輕量分類/摘要任務

# ── PubMed / NCBI ────────────────────────────────────────────
# 申請：https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@example.com            # NCBI 要求提供聯絡 Email

# ── SERP API ─────────────────────────────────────────────────
# 申請：https://serper.dev（推薦）或 https://serpapi.com
SERPER_API_KEY=your-serper-api-key-here
# SERPAPI_KEY=your-serpapi-key-here          # 備選

# ── 圖片生成 API ──────────────────────────────────────────────
# DALL-E 3 使用 OPENAI_API_KEY，無需額外設定
# Flux / Replicate（備選）
# REPLICATE_API_TOKEN=r8_...

# ── Google API ───────────────────────────────────────────────
# 申請：https://console.cloud.google.com
# 用途：Google Sheets 排程表、Google Docs 匯出
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEETS_SCHEDULE_ID=your-google-sheet-id-here

# ── WordPress ────────────────────────────────────────────────
WORDPRESS_SITE_URL=https://your-site.com
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_APP_PASSWORD=your-wp-app-password  # WordPress Application Password

# ── 資料儲存 ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/contentflow.db
# PostgreSQL（Docker Compose 開發環境）：
# DATABASE_URL=postgresql+asyncpg://contentflow:changeme@localhost:5432/contentflow
DB_PASSWORD=changeme                         # Docker Compose PostgreSQL 密碼

# ── API 認證 ──────────────────────────────────────────────────
# 用於 FastAPI X-API-Key header 驗證，請設定一組隨機強密碼
API_SECRET_KEY=your-strong-api-secret-key-here

# ── ForgeBase ─────────────────────────────────────────────────
# ContentFlow 透過 X-API-Key 認證呼叫 ForgeBase API。
# 設定步驟：
#   1. 在 ForgeBase Admin 建立 role=marketing_manager 的 service account user
#   2. 生成一組 token: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   3. 在 ForgeBase .env 填入 SERVICE_ACCOUNT_TOKENS=<token>:<user_id>
#   4. 將同一組 token 填入下方 FORGEBASE_API_TOKEN
FORGEBASE_API_BASE_URL=https://your-forgebase-instance.com
FORGEBASE_API_TOKEN=your-forgebase-service-account-token

# ── 排程設定 ──────────────────────────────────────────────────
SCHEDULER_ENABLED=false                      # 本機開發建議關閉
SCHEDULER_TIMEZONE=Asia/Taipei

# ── 通知 ──────────────────────────────────────────────────────
# Slack Webhook（可選，草稿通知 / 排程失敗警示）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── 系統設定 ──────────────────────────────────────────────────
LOG_LEVEL=INFO                               # DEBUG / INFO / WARNING / ERROR
OUTPUT_DIR=./outputs
MAX_ARTICLES_PER_RUN=5                       # 每次批次上限
