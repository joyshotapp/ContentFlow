FROM node:22-slim AS site-assets

WORKDIR /app

COPY tailwind.site.config.js ./
COPY src/contentflow/site/templates ./src/contentflow/site/templates
COPY src/contentflow/site/static/css/site.input.css ./src/contentflow/site/static/css/site.input.css

RUN npx --yes tailwindcss@3.4.17 \
    -c tailwind.site.config.js \
    -i ./src/contentflow/site/static/css/site.input.css \
    -o ./src/contentflow/site/static/css/site.css \
    --minify

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ ./src/
COPY --from=site-assets /app/src/contentflow/site/static/css/site.css ./src/contentflow/site/static/css/site.css

# 安裝網站 + AI pipeline 所需依賴
RUN pip install --no-cache-dir \
    fastapi "uvicorn[standard]" \
    jinja2 markdown \
    sqlalchemy psycopg2-binary \
    pydantic pydantic-settings \
    loguru python-dotenv \
    alembic \
    "python-multipart>=0.0.9" itsdangerous \
    langgraph langchain "langchain-openai>=0.2.0" "langchain-anthropic>=0.3.0" \
    openai anthropic \
    httpx aiohttp requests \
    openpyxl beautifulsoup4 lxml \
    apscheduler \
    "google-api-python-client>=2.140.0" google-auth-httplib2 google-auth-oauthlib \
    "google-analytics-data>=0.18.0" \
    chromadb \
    agentops==0.4.21 \
    "google-genai>=1.0.0" \
    "boto3>=1.35.0" \
    && pip install --no-cache-dir -e . --no-deps

COPY data/ ./data/
COPY migrations/ ./migrations/
COPY alembic.ini .

EXPOSE 8000
