# ===== ContentFlow Managed Site Environment =====
# 適用於需要公開前台站點的實例；複製此檔為 .env.prod 後填入真實值。

# ── LLM ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_WRITING_MODEL=claude-sonnet-4-5
LLM_LITE_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────
DB_PASSWORD=changeme_use_strong_password

# ── SERP / Research ────────────────────────
SERPER_API_KEY=
SERPAPI_KEY=
NCBI_API_KEY=
NCBI_EMAIL=

# ── Managed Site Branding ──────────────────
SITE_URL=https://example.com
SITE_NAME=ContentFlow Managed Site
SITE_DESCRIPTION=以 AI 與 SEO 控制平面驅動的內容站台。
SITE_CONTACT_EMAIL=editor@example.com
GA4_MEASUREMENT_ID=

# ── Security ───────────────────────────────
API_SECRET_KEY=changeme_use_strong_random_key
ADMIN_REVIEWER_SECRET=changeme_reviewer_secret
ADMIN_EDITOR_SECRET=changeme_editor_secret
CONNECTOR_SECRET_KEY=
CHROMA_PERSIST_DIR=/app/data/chroma

# ── Deployment Mode ─────────────────────────
PLATFORM_MODE=managed-site
MANAGED_SITE_ENABLED=true

# ── Runtime ─────────────────────────────────
LOG_LEVEL=INFO
OUTPUT_DIR=/app/outputs
MAX_ARTICLES_PER_RUN=5
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Taipei