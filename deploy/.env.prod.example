# ===== GoodBone Production Environment =====
# 複製此檔為 .env.prod 並填入真實值後再部署
# cp .env.prod.example .env.prod

# ── LLM ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_WRITING_MODEL=claude-sonnet-4-5
LLM_LITE_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────
DB_PASSWORD=changeme_use_strong_password
# DATABASE_URL 由 docker-compose.prod.yml 自動注入

# ── NCBI / PubMed ───────────────────────────
NCBI_API_KEY=
NCBI_EMAIL=

# ── SERP ────────────────────────────────────
SERPER_API_KEY=
SERPAPI_KEY=

# ── Reference Site ──────────────────────────
SITE_URL=https://goodbone.com.tw
SITE_NAME=GoodBone 好骨頭
SITE_DESCRIPTION=以醫學文獻為基礎的骨科健康知識平台——AI 驅動的 SEO 內容引擎，幫助您了解骨骼健康、關節保護與骨科治療。

# ── Google Analytics ────────────────────────
GA4_MEASUREMENT_ID=

# ── API 安全 ─────────────────────────────────
API_SECRET_KEY=changeme_use_strong_random_key

# ── 系統 ─────────────────────────────────────
LOG_LEVEL=INFO
OUTPUT_DIR=/app/outputs
MAX_ARTICLES_PER_RUN=5
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Taipei
